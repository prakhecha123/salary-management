source "https://rubygems.org"

ruby "3.3.5"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
# >= 7.2.3.1 required: activesupport had an XSS CVE (GHSA-89vf-4333-qx8v) and
# a DoS CVE (GHSA-2j26-frm8-cmj9), fixed starting in 7.2.3.1.
gem "rails", "~> 7.2.3", ">= 7.2.3.1"

# Use sqlite3 as the database for Active Record in development/test.
# >= 2.9 required: 1.7.3 (the version ~> 1.4 previously resolved to) has two
# use-after-free CVEs (GHSA-mwm8-39rw-8826, GHSA-28hh-pr2h-2w89).
gem "sqlite3", "~> 2.9"

# Use Postgres in production (see docs/trade-offs.md)
gem "pg", "~> 1.5", group: :production

# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"

# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Use Kredis to get higher-level data types in Redis [https://github.com/rails/kredis]
# gem "kredis"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ mswin mswin64 mingw x64_mingw jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Ruby 3.5 removes this from the default gems; Rails' JSON handling still needs it.
gem "ostruct"

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
# gem "image_processing", "~> 1.2"

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri mswin mswin64 mingw x64_mingw ]

  gem "rspec-rails", "~> 6.1"
  gem "factory_bot_rails", "~> 6.4"
  gem "faker", "~> 3.4"
end

